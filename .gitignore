# ── 저작권: 수집한 타사 페이지 원본은 저장소에 올리지 않는다 ──────────────
# 재현은 refs.yaml(URL 목록) + 수집 스크립트로 한다.
data/refs/*/
!data/refs/.gitkeep
*.png
*.jpg
*.jpeg
*.webp
# 단, 내 소유 자산과 문서용 시연 스크린샷은 예외
!docs/assets/**
!data/samples/**

# 산출물 — 중간물은 빼고 최종 HTML 두 장만 남긴다.
# 심사자가 클론만 하고도 결과를 열어볼 수 있어야 하기 때문이다.
# (원본 스크린샷은 여전히 제외되며, 여기 들어가는 것은 추출된 짧은 카피와 수치뿐이다)
out/*
!out/.gitkeep
!out/research.html
!out/patterns.html
!out/swatchbook.html

# 파이썬
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# 비밀
.env
.env.*
!.env.example

# macOS
.DS_Store
